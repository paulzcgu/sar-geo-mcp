# sar-geo-mcp environment. Copy to .env and fill in. .env is gitignored.
#
# This package does NOT load .env by itself - it reads plain environment
# variables (config.py `CaltopoConfig.from_env`). Load the file one of these ways:
#   shell:        set -a; source .env; set +a
#   Claude Code:  claude mcp add sar-geo -e ZA_WMS_TOKEN=... -- sar-geo-mcp
# Every variable is optional: blank or unset means the default shown.

# --- CalTopo account (authenticated map reads) -------------------------------
# Public maps need none of this. Private maps need a cts.ini (see
# cts.ini.example); a read-only team key is enough.
ZA_CALTOPO_HOST=caltopo.com
ZA_CALTOPO_CONFIG_PATH=cts.ini
# The [section] name in cts.ini. May stay blank when cts.ini has exactly one.
ZA_CALTOPO_ACCOUNT=

# --- CalTopo WMS token --------------------------------------------------------
# From the CalTopo account page, "API Access" block. Needed by the raster
# tools (shaded_relief, slope_shading), the canopy panel fetch and the
# CalTopo imagery chips in lz_candidates. Lands in a URL: never log it.
ZA_WMS_TOKEN=

# --- Optional imagery sources for lz_candidates chips -------------------------
# Neither is required; the CalTopo chips work without them.
ZA_MAPBOX_TOKEN=
# Read Google's terms on static-image use before setting this.
ZA_GOOGLE_MAPS_KEY=

# --- Local paths and services -------------------------------------------------
# Tile and map-state cache, relative to where the server runs.
ZA_CACHE_DIR=cache
# Replacement assignment-norms JSON for another agency. Blank = shipped file.
ZA_ASSIGNMENT_NORMS=
# Your own Overpass instance(s), comma-separated. Blank = the public mirrors.
ZA_OVERPASS_URLS=

# --- Hospitals and road routing (nearest_medical_facilities) -----------------
# Blank = the public defaults: FEMA's copy of HIFLD Hospitals, and the OSRM
# project's public demo router (light use only - run your own for more).
ZA_HOSPITALS_URL=
ZA_OSRM_URL=
# US Census state boundaries, to warn when a point is outside the US (the
# hospital list is US-only). Blank = Census TIGERweb.
ZA_US_STATES_URL=

# --- Tests only ---------------------------------------------------------------
# Cache kept between `pytest -m live` runs, so a retry does not refetch tiles.
ZA_LIVE_CACHE_DIR=
